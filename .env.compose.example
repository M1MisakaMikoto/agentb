COMPOSE_PROJECT_NAME=agentb-dev
AGENTB_PORT=8152
AGENTB_SETTING_FILE=./.dev/setting.json

MYSQL_DATABASE=agentb
MYSQL_USER=agentb
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password

AGENTB_REDIS_URL=redis://redis:6379/0
AGENTB_REDIS_PREFIX=agentb:dev:
AGENTB_OWNER_LEASE_SECONDS=60
AGENTB_HEARTBEAT_SECONDS=15
AGENTB_DRAIN_TIMEOUT_SECONDS=30
AGENTB_STREAM_MAXLEN=10000
AGENTB_STREAM_RETENTION_SECONDS=86400
AGENTB_WORKSPACE_DIR=/app/workspaces
AGENTB_RAG_LEASE_SECONDS=1800
# Set to 1 to run RAG ingestion/search without an external embedding service
# (dummy zero vectors; retrieval is not semantically ranked).
AGENTB_EMBEDDING_DISABLED=1
AGENTB_API_CPU_LIMIT=2.0
AGENTB_API_MEMORY_LIMIT=2G
AGENTB_API_MEMORY_RESERVATION=512M
AGENTB_RAG_CPU_LIMIT=4.0
AGENTB_RAG_MEMORY_LIMIT=4G

# 上游工具 MCP 服务（报告上传/巡查记录/AI 研判）：地址与上游系统配置
AGENTB_MCP_UPSTREAM_TOOLS_URL=http://agentb-mcp-upstream-tools:8181/mcp
AGENTB_MCP_UPSTREAM_TOOLS_TIMEOUT_SECONDS=60
AGENTB_MCP_UPSTREAM_TOOLS_PROBE_TIMEOUT_SECONDS=5
AGENTB_MCP_UPSTREAM_CONFIG_FILE=./WorkBranch/mcp_servers/upstream_tools/config.example.json
AGENTB_MCP_CPU_LIMIT=1.0
AGENTB_MCP_MEMORY_LIMIT=1G

# Leave these empty to use values from AGENTB_SETTING_FILE.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Platform mode only. The router joins this pre-existing Docker network.
AGENTB_PLATFORM_NETWORK=platform-proxy
