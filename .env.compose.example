COMPOSE_PROJECT_NAME=agentb-dev
AGENTB_PORT=8152

MYSQL_DATABASE=agentb
MYSQL_USER=agentb
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password

AGENTB_REDIS_URL=redis://redis:6379/0
AGENTB_REDIS_PREFIX=agentb:dev:
AGENTB_OWNER_LEASE_SECONDS=60
AGENTB_HEARTBEAT_SECONDS=15
AGENTB_DRAIN_TIMEOUT_SECONDS=30
AGENTB_STREAM_MAXLEN=10000
AGENTB_STREAM_RETENTION_SECONDS=86400
AGENTB_WORKSPACE_DIR=/app/workspaces
AGENTB_RAG_LEASE_SECONDS=1800
AGENTB_API_CPU_LIMIT=2.0
AGENTB_API_MEMORY_LIMIT=2G
AGENTB_API_MEMORY_RESERVATION=512M
AGENTB_RAG_CPU_LIMIT=4.0
AGENTB_RAG_MEMORY_LIMIT=4G

LLM_API_KEY=change_me
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-plus

# Platform mode only. The router joins this pre-existing Docker network.
AGENTB_PLATFORM_NETWORK=platform-proxy
